# ===========================================================================================
# Fábrica de Reels — configuração da pessoa. O /comecar preenche isto contigo.
# É PRIVADO: tem a tua chave da Zernio. Nunca o partilhes nem o envies a ninguém.
# ===========================================================================================

# --- Pessoa e conta ---------------------------------------------------------------------------
NOME_PESSOA=
INSTAGRAM_CONTA=
# sim / nao (muda o volume diário: 6-10 reels se não verificada)
INSTAGRAM_VERIFICADA=nao
# para onde vai o relatório de 14 dias (o próprio dono da conta) e por que ligação de email
RELATORIO_EMAIL=
RELATORIO_LIGACAO=
# Cópia oculta (BCC) dos relatórios para a Agens — caso de estudo da fase gratuita (só se REGISTO_AGENS=sim)
RELATORIO_BCC=daniel.costa@agens.pt

# --- Zernio (publica os trial reels e responde aos comentários) -------------------------------
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=

# --- Imagens grátis (opcional: sem chave usa só Openverse e Wikimedia) ------------------------
PIXABAY_API_KEY=

# --- Pastas na Google Drive (ids; o /comecar cria-as e preenche) ------------------------------
# RAW, B-rolls e Músicas ficam partilhadas por link (só leitura) para os scripts as lerem sozinhos.
DRIVE_PASTA_RAIZ=
DRIVE_PASTA_BROLLS=
DRIVE_PASTA_MUSICAS=
DRIVE_PASTA_RECURSOS=
DRIVE_PASTA_TALKING_HEAD_RAW=
DRIVE_PASTA_TALKING_HEAD_PUBLICADOS=

# --- CTAs da última página dos recursos (só aparecem os preenchidos) --------------------------
CTA_COMUNIDADE_NOME=
CTA_COMUNIDADE_LINK=
CTA_INSTAGRAM_LINK=
CTA_REUNIAO_LINK=
CTA_SITE_LINK=

# --- Texto no ecrã dos reels (fixo para todos: é o estilo que funciona) -----------------------
FONTE_FICHEIRO=ferramentas/fontes/Montserrat-Variable.ttf
FONTE_PESO=SemiBold
FONTE_ITALICO_FICHEIRO=ferramentas/fontes/Montserrat-Italic-Variable.ttf
FONTE_ITALICO_PESO=Medium Italic
# cores de destaque no hook, por ordem de preferência (escolhida pelo contraste com o fundo)
CORES_DESTAQUE=#F4EE00,#FFC107,#FF8A00,#00E5FF
# palavras que nunca aparecem num hook (separadas por vírgula; ex.: o nome da tua empresa)
HOOK_PALAVRAS_PROIBIDAS=

# --- Estética dos documentos (recursos em PDF e relatórios) -----------------------------------
# cores em hex; letras do Google Fonts (nome exato, ex.: Playfair Display, Inter, Montserrat)
MARCA_COR_PRINCIPAL=#1F3A5F
MARCA_COR_SECUNDARIA=#E8EEF6
MARCA_LETRA_TITULOS=Montserrat
MARCA_LETRA_TEXTO=Inter

# --- Publicação -------------------------------------------------------------------------------
FUSO=Europe/Lisbon
HORA_INICIO=09:00
HORA_FIM=20:30
# sim = a fábrica diária publica os reels de texto sozinha
FABRICA_LIGADA=nao
# sim = autorizaste o Claude a trabalhar sozinho (talking heads e análise de 14 dias)
AUTOMATICO_CLAUDE=nao
# sim = aceitaste partilhar os números do Instagram com a Agens (caso de estudo da fase gratuita)
REGISTO_AGENS=nao
